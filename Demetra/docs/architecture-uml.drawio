whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="80" y="225" width="270" height="20" as="geometry"/></mxCell><mxCell id="S16" value="[грешен CSRF токен]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="80" y="283" width="270" height="20" as="geometry"/></mxCell><mxCell id="S17" value="302 → /login" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="262" as="sourcePoint"/><mxPoint x="90" y="262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S18" value="" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="278" as="sourcePoint"/><mxPoint x="360" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S19" value="403 Forbidden" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="322" as="sourcePoint"/><mxPoint x="90" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S20" value="3: registerForEvent(5, principal)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="375" as="sourcePoint"/><mxPoint x="440" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S21" value="4: findById(5)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="415" as="sourcePoint"/><mxPoint x="620" y="415" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S22" value="5: findById(5)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="445" as="sourcePoint"/><mxPoint x="800" y="445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S23" value="6: SELECT … FR