rent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="685" as="sourcePoint"/><mxPoint x="1160" y="685" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S31" value="няма ред" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="715" as="sourcePoint"/><mxPoint x="980" y="715" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S32" value="Optional.empty()" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="740" as="sourcePoint"/><mxPoint x="620" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S33" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=45;height=20;fillColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="755" width="300" height="60" as="geometry"/></mxCell><mxCell id="S34" value="[вече е записан]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="450" y="758" width="240" height="20" as="geometry"/></mxCell><mxCell id="S35" value="throw IllegalStateException" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="800" as="sourcePoint"/><mxPoint x="440" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S36" value="10: countByEventAndStatus(event, CONFIRMED)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="850" as="sourcePoint"/><mxPoint x="980" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S37" value="11: SELECT COUNT(*) …" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="880" as="sourcePoint"/><mxPoint x="1160" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S38" value="n" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="910" as="sourcePoint"/><mxPoint x="980" y="910" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S39" value="n" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="935" as="sourcePoint"/><mxPoint x="620" y="935" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S40" value="status = n &amp;lt; capacity ? CONFIRMED : WAITLISTED" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;align=left;spacingLeft=40;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="965" as="sourcePoint"/><mxPoint x="620" y="990" as="targetPoint"/><Array as="points"><mxPoint x="655" y="965"/><mxPoint x="655" y="990"/></Array></mxGeometry></mxCell><mxCell id="S41" value="12: save(new Registration(user, event, status))" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1030" as="sourcePoint"/><mxPoint x="980" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S42" value="13: INSERT INTO registrations …" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="1060" as="sourcePoint"/><mxPoint x="1160" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S43" value="ok" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="1090" as="sourcePoint"/><mxPoint x="980" y="1090" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S44" value="Registration" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="1115" as="sourcePoint"/><mxPoint x="620" y="1115" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S45" value="COMMIT" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="630" y="1122" width="70" height="22" as="geometry"/></mxCell><mxCell id="S46" value="Registration (CONFIRMED)" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1160" as="sourcePoint"/><mxPoint x="440" y="1160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S47" value="14: 302 Location: /events/5 (flash „message“)" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1195" as="sourcePoint"/><mxPoint x="90" y="1195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S48" value="15: GET /events/5" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="1240" as="sourcePoint"/><mxPoint x="260" y="1240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S49" value="16: view(5)" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="1270" as="sourcePoint"/><mxPoint x="440" y="1270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S50" value="17: findById, confirmedCount, findRegistration" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1300" as="sourcePoint"/><mxPoint x="620" y="1300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S51" value="същите стъпки през хранилищата → 3 × SELECT" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="640" y="1312" width="330" height="24" as="geometry"/></mxCell><mxCell id="S52" value="18: &quot;events/view&quot; + Model" style="html=1;endArrow=block;endFill=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="1360" as="sourcePoint"/><mxPoint x="1340" y="1360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="S53" value="19: 200 OK, HTML: „You're registered for this event.“" style="html=1;endArrow=open;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="1400" as="sourcePoint"/><mxPoint x="90" y="1400" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="V" name="6 Валидация, изключения, достъп"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="V2" value="Фиг. 4. Валидация, обработка на изключения и контрол на достъпа" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="V3" value="&lt;b&gt;HTTP заявка&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="640" height="40" as="geometry"/></mxCell><mxCell id="V4" value="&lt;b&gt;1. Контрол на достъпа (Spring Security, SecurityConfig)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• вход с имейл и парола, пароли с BCrypt&lt;br&gt;• authorizeHttpRequests: /, /login, /register, /users, GET /events/* – свободни;&lt;br&gt;&amp;nbsp;&amp;nbsp;/events/new, /reports/** – ORGANIZER; /admin/** – ADMIN; останалото – влязъл потребител&lt;br&gt;• CSRF токен във всяка POST форма&lt;br&gt;• деактивиран профил: isEnabled() = false → не може да влезе&lt;br&gt;• сесии в MySQL; при смяна на роля или деактивиране сесиите се изтриват&lt;br&gt;• sec:authorize в шаблоните скрива бутоните за чужди роли&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="640" height="156" as="geometry"/></mxCell><mxCell id="V5" value="" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="V3" target="V4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="V6" value="&lt;b&gt;2. Валидация на входа (Controller)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• @ModelAttribute + BindingResult: грешен тип не дава грешка 500&lt;br&gt;• @DateTimeFormat за дати; parsePage, fromKey, normalize → стойности по подразбиране&lt;br&gt;• AuthController / EventController: дължини, имейл, парола, дата на събитие&lt;br&gt;• администраторът не може да промени собствената си роля или да се деактивира&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="640" height="108" as="geometry"/></mxCell><mxCell id="V7" value="" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="V4" target="V6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="V8" value="&lt;b&gt;3. Бизнес правила (Service)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• UserService: validName, validEmail, validPhone, validatePassword, уникален имейл&lt;br&gt;• ReportPeriod.between: от/до дата, начало ≤ край, край не в бъдещето, най-много 2 години&lt;br&gt;• EventService: двоен запис забранен, капацитет → WAITLISTED&lt;br&gt;• @Transactional: при изключение промените се отменят&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="640" height="108" as="geometry"/></mxCell><mxCell id="V9" value="" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="V6" target="V8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="V10" value="&lt;b&gt;4. База данни (Repository / MySQL)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;• UNIQUE email в users&lt;br&gt;• UNIQUE (user_id, event_id) в registrations&lt;br&gt;• NOT NULL колони&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="640" height="92" as="geometry"/></mxCell><mxCell id="V11" value="" style="html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="V8" target="V10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="V12" value="&lt;b&gt;Обработка на изключения&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="60" width="720" height="30" as="geometry"/></mxCell><mxCell id="V13" value="&lt;b&gt;Ситуация / изключение&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#EEEEEE;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="300" height="30" as="geometry"/></mxCell><mxCell id="V14" value="&lt;b&gt;Къде се обработва&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#EEEEEE;" vertex="1" parent="1"><mxGeometry x="1040" y="95" width="200" height="30" as="geometry"/></mxCell><mxCell id="V15" value="&lt;b&gt;Резултат за потребителя&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#EEEEEE;" vertex="1" parent="1"><mxGeometry x="1240" y="95" width="220" height="30" as="geometry"/></mxCell><mxCell id="V16" value="Не е влязъл, защитен адрес" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="125" width="300" height="46" as="geometry"/></mxCell><mxCell id="V17" value="ExceptionTranslationFilter" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="125" width="200" height="46" as="geometry"/></mxCell><mxCell id="V18" value="302 → /login" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="125" width="220" height="46" as="geometry"/></mxCell><mxCell id="V19" value="Грешна роля (напр. STUDENT → /admin)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="171" width="300" height="46" as="geometry"/></mxCell><mxCell id="V20" value="AccessDeniedHandler" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="171" width="200" height="46" as="geometry"/></mxCell><mxCell id="V21" value="403 Forbidden" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="171" width="220" height="46" as="geometry"/></mxCell><mxCell id="V22" value="Липсващ или грешен CSRF токен" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="217" width="300" height="46" as="geometry"/></mxCell><mxCell id="V23" value="CsrfFilter" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="217" width="200" height="46" as="geometry"/></mxCell><mxCell id="V24" value="403 Forbidden" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="217" width="220" height="46" as="geometry"/></mxCell><mxCell id="V25" value="Грешна парола / деактивиран профил" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="263" width="300" height="46" as="geometry"/></mxCell><mxCell id="V26" value="formLogin failureUrl" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="263" width="200" height="46" as="geometry"/></mxCell><mxCell id="V27" value="302 → /login?error" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="263" width="220" height="46" as="geometry"/></mxCell><mxCell id="V28" value="IllegalArgumentException (невалиден имейл, телефон, парола, роля)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="309" width="300" height="46" as="geometry"/></mxCell><mxCell id="V29" value="try/catch в контролера" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="309" width="200" height="46" as="geometry"/></mxCell><mxCell id="V30" value="същата форма със съобщение или flash „error“" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="309" width="220" height="46" as="geometry"/></mxCell><mxCell id="V31" value="IllegalStateException (вече записан / не е записан)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="355" width="300" height="46" as="geometry"/></mxCell><mxCell id="V32" value="try/catch в EventController" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="355" width="200" height="46" as="geometry"/></mxCell><mxCell id="V33" value="redirect + flash „error“" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="355" width="220" height="46" as="geometry"/></mxCell><mxCell id="V34" value="Невалиден период на отчет" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="401" width="300" height="46" as="geometry"/></mxCell><mxCell id="V35" value="ReportController" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="401" width="200" height="46" as="geometry"/></mxCell><mxCell id="V36" value="400 + съобщение на страницата" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="401" width="220" height="46" as="geometry"/></mxCell><mxCell id="V37" value="Несъществуващ потребител /admin/users/{id}" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="447" width="300" height="46" as="geometry"/></mxCell><mxCell id="V38" value="ResponseStatusException" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="447" width="200" height="46" as="geometry"/></mxCell><mxCell id="V39" value="404 Not Found" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="447" width="220" height="46" as="geometry"/></mxCell><mxCell id="V40" value="Грешен параметър (page=abc, period=???)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="493" width="300" height="46" as="geometry"/></mxCell><mxCell id="V41" value="BindingResult / парсване" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="493" width="200" height="46" as="geometry"/></mxCell><mxCell id="V42" value="стойност по подразбиране" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="493" width="220" height="46" as="geometry"/></mxCell><mxCell id="V43" value="Стара сесия от предишна версия" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="740" y="539" width="300" height="46" as="geometry"/></mxCell><mxCell id="V44" value="SessionConfig (конвертор)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="539" width="200" height="46" as="geometry"/></mxCell><mxCell id="V45" value="потребителят е изпратен към вход, без 500" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1240" y="539" width="220" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="D" name="3, 7 Обосновка и решения"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="D2" value="Фиг. 5. Избран архитектурен подход и анализ на решенията" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="D3" value="&lt;b&gt;Избран подход: Layered Architecture (Presentation → Controller → Service → Repository → Persistence) с MVC в горните слоеве&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Spring MVC дава MVC наготово: DispatcherServlet е Front Controller, контролерите са C, Thymeleaf изгледите са V, а models + services са M.&lt;br&gt;• Слоевете разделят отговорностите: контролерът не знае SQL, услугата не знае HTML, хранилището не съдържа бизнес правила. Промяна в един слой рядко засяга друг.&lt;br&gt;• Всеки слой се тества отделно: MockMvc за контролерите, H2 вместо MySQL, чисти unit тестове за анализа (141 теста).&lt;br&gt;• Транзакциите са на ниво Service, а сигурността е филтър пред всички контролери, затова нито едно от двете не се повтаря във всеки метод.&lt;br&gt;• Едно приложение, една база и малък домейн (потребители, събития, отчети): монолит по слоеве е най-простото решение, което покрива изискванията." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1420" height="190" as="geometry"/></mxCell><mxCell id="D4" value="&lt;b&gt;Решение&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fillColor=#EEEEEE;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="230" height="30" as="geometry"/></mxCell><mxCell id="D5" value="&lt;b&gt;Алтернатива&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fillColor=#EEEEEE;" vertex="1" parent="1"><mxGeometry x="270" y="270" width="210" height="30" as="geometry"/></mxCell><mxCell id="D6" value="&lt;b&gt;Защо избраното е подходящо за Demetra&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fillColor=#EEEEEE;" vertex="1" parent="1"><mxGeometry x="480" y="270" width="620" height="30" as="geometry"/></mxCell><mxCell id="D7" value="&lt;b&gt;Цена на решението&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;fillColor=#EEEEEE;" vertex="1" parent="1"><mxGeometry x="1100" y="270" width="360" height="30" as="geometry"/></mxCell><mxCell id="D8" value="&lt;b&gt;1. Монолит по слоеве&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="230" height="80" as="geometry"/></mxCell><mxCell id="D9" value="Микросървиси" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="210" height="80" as="geometry"/></mxCell><mxCell id="D10" value="Една база и свързани данни (събития ↔ записвания ↔ потребители). Една транзакция покрива целия запис. Един Docker контейнер за приложението." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="620" height="80" as="geometry"/></mxCell><mxCell id="D11" value="Цялото приложение се мащабира заедно; при голям растеж частите трудно се отделят." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="360" height="80" as="geometry"/></mxCell><mxCell id="D12" value="&lt;b&gt;2. Server-side MVC с Thymeleaf&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="230" height="80" as="geometry"/></mxCell><mxCell id="D13" value="SPA (React/Angular) + REST API" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="380" width="210" height="80" as="geometry"/></mxCell><mxCell id="D14" value="Няма отделен фронтенд проект и API слой. Сесия + CSRF идват от Spring Security. Страниците работят и без JavaScript." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="620" height="80" as="geometry"/></mxCell><mxCell id="D15" value="По-малко интерактивност; всяко действие презарежда страницата." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="380" width="360" height="80" as="geometry"/></mxCell><mxCell id="D16" value="&lt;b&gt;3. Сесии в MySQL (Spring Session JDBC)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="230" height="80" as="geometry"/></mxCell><mxCell id="D17" value="JWT токени или сесии в паметта" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="460" width="210" height="80" as="geometry"/></mxCell><mxCell id="D18" value="Сесиите оцеляват при рестарт на контейнера и могат да се прекратят веднага (деактивиране, смяна на роля). JWT не може да се отмени преди изтичането си." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="460" width="620" height="80" as="geometry"/></mxCell><mxCell id="D19" value="Една заявка към базата за всяка HTTP заявка; сериализацията изисква внимание при промени в класовете." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="460" width="360" height="80" as="geometry"/></mxCell><mxCell id="D20" value="&lt;b&gt;4. Soft delete (deactivatedAt)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="230" height="80" as="geometry"/></mxCell><mxCell id="D21" value="Изтриване на реда" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="540" width="210" height="80" as="geometry"/></mxCell><mxCell id="D22" value="Събитията, записванията и отчетите остават пълни; профилът може да се активира отново. Колоната е NULL, затова автоматичната миграция не деактивира съществуващите потребители." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="540" width="620" height="80" as="geometry"/></mxCell><mxCell id="D23" value="Всяка заявка за „активни“ трябва да филтрира по deactivatedAt." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="540" width="360" height="80" as="geometry"/></mxCell><mxCell id="D24" value="&lt;b&gt;5. Анализ в приложението (регресия, z-score)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="230" height="80" as="geometry"/></mxCell><mxCell id="D25" value="Външен AI / LLM API" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="270" y="620" width="210" height="80" as="geometry"/></mxCell><mxCell id="D26" value="Без API ключ, без разходи и без изпращане на лични данни навън. Резултатите са детерминистични, тестируеми и всеки извод може да се провери." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="620" width="620" height="80" as="geometry"/></mxCell><mxCell id="D27" value="По-прости модели; не разбира свободен текст." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="620" width="360" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>